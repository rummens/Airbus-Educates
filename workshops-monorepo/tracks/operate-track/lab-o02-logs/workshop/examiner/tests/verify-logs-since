#!/bin/bash
# A time-bounded read works and returns the recent lines rather than everything.
set -uo pipefail
out=$(oc logs -l app=hello-dcs --since=5m --tail=50 --prefix 2>/dev/null)
if [ -z "$out" ]; then
  echo "❌ '--since=5m' returned nothing. The app logged its startup within the last few minutes, so an empty result suggests the Pods restarted or the selector matched nothing." >&2
  exit 1
fi
n=$(echo "$out" | grep -c .)
echo "✅ A 5-minute window returned ${n} line(s) — the flag to reach for during an incident."
