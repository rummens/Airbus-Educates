#!/bin/bash
# The Route must NOT exist in DEV: admission refused it. Asserting an absence is the
# point — a Route here would mean the policy is not enforcing.
set -uo pipefail
if oc get route hello-dcs -n "$DEV_NS" >/dev/null 2>&1; then
  echo "❌ A Route exists in $DEV_NS, but a DEV-type namespace must not be able to publish one. The policy is not enforcing — check: oc get clusterpolicy dcs-nstype-\$(oc project -q) -o yaml" >&2
  exit 1
fi
if ! oc get deployment hello-dcs -n "$DEV_NS" >/dev/null 2>&1; then
  echo "❌ There is no app in $DEV_NS at all, so the refused Route proves nothing yet. Run the earlier steps on this page first." >&2
  exit 1
fi
echo "✅ No Route in $DEV_NS — the apply was refused, exactly as a DEV-type namespace should."
