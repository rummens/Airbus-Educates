#!/bin/bash
# With requests and limits declared, the identical app is admitted and runs.
set -uo pipefail
# The session sets these; derive them if a caller did not.
DEV_NS="${DEV_NS:-$(oc project -q)-dev}"
PROD_NS="${PROD_NS:-$(oc project -q)-prod}"
for _ in $(seq 1 24); do
  ready=$(oc get deployment hello-dcs -n "$PROD_NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
  [ "${ready:-0}" -ge 1 ] 2>/dev/null && break
  sleep 5
done
if [ "${ready:-0}" -lt 1 ] 2>/dev/null; then
  echo "❌ hello-dcs is not ready in $PROD_NS (${ready:-0}). Did 'envsubst < hello-dcs-sized.yaml | oc apply -f - -n \$PROD_NS' run and finish rolling out?" >&2
  exit 1
fi
lim=$(oc get deployment hello-dcs -n "$PROD_NS" -o jsonpath='{.spec.template.spec.containers[0].resources.limits.memory}' 2>/dev/null)
if [ -z "$lim" ]; then
  echo "❌ The Deployment in $PROD_NS runs but declares no memory limit — which the policy should have refused. Check the policy is enforcing." >&2
  exit 1
fi
echo "✅ PROD accepted the sized workload: ${ready} ready, memory limit ${lim}."
