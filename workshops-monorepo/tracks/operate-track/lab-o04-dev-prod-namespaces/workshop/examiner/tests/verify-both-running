#!/bin/bash
# The app runs in both namespaces, and the two differ in exactly one way: PROD
# declares resources, DEV took the defaults.
set -uo pipefail
d=$(oc get deployment hello-dcs -n "$DEV_NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
p=$(oc get deployment hello-dcs -n "$PROD_NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
if [ "${d:-0}" -lt 1 ] 2>/dev/null || [ "${p:-0}" -lt 1 ] 2>/dev/null; then
  echo "❌ Expected the app ready in both namespaces, found DEV=${d:-0} PROD=${p:-0}. This check keeps retrying while rollouts finish." >&2
  exit 1
fi
dres=$(oc get deployment hello-dcs -n "$DEV_NS" -o jsonpath='{.spec.template.spec.containers[0].resources}' 2>/dev/null)
pres=$(oc get deployment hello-dcs -n "$PROD_NS" -o jsonpath='{.spec.template.spec.containers[0].resources.requests.cpu}' 2>/dev/null)
echo "✅ Running in both: DEV (declared resources: ${dres:-none}) and PROD (cpu request ${pres}) — two running states from two manifests, which is what promotion prevents."
