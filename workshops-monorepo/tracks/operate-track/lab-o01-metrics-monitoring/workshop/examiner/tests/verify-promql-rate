#!/bin/bash
# A real question, not just presence: per-second request rate, summed per Pod.
set -uo pipefail
TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token 2>/dev/null)
NS=$(oc project -q 2>/dev/null)
URL="${THANOS_URL:-https://thanos-querier.openshift-monitoring.svc:9092}"
for _ in $(seq 1 12); do          # ~120s
  body=$(curl -sk -H "Authorization: Bearer $TOKEN" --max-time 15 \
          --get "$URL/api/v1/query" \
          --data-urlencode "namespace=$NS" \
          --data-urlencode 'query=sum by (pod) (rate(hello_dcs_requests_total[5m]))' 2>/dev/null)
  case "$body" in
    *'"status":"success"'*'"pod"'*)
      echo "✅ The rate query returned a per-Pod result — the shape behind most dashboard panels."
      exit 0 ;;
  esac
  sleep 10
done
echo "❌ The rate query returned no per-Pod result after 2 minutes. rate() needs at least two samples in the window, so it can trail the first successful instant query by an interval. Got: $(printf '%s' "${body:-<empty>}" | cut -c1-200)" >&2
exit 1
