#!/bin/bash
# The app's own series must come back from the platform's tenant query endpoint.
#
# Waits: scraping starts within an interval or two of the ServiceMonitor being created,
# so an empty result immediately afterwards is normal rather than wrong.
set -uo pipefail
TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token 2>/dev/null)
NS=$(oc project -q 2>/dev/null)
URL="${THANOS_URL:-https://thanos-querier.openshift-monitoring.svc:9092}"
for _ in $(seq 1 18); do          # ~180s
  body=$(curl -sk -H "Authorization: Bearer $TOKEN" --max-time 15 \
          --get "$URL/api/v1/query" \
          --data-urlencode "namespace=$NS" \
          --data-urlencode 'query=hello_dcs_up' 2>/dev/null)
  case "$body" in
    *'"status":"success"'*'"__name__":"hello_dcs_up"'*)
      pods=$(printf '%s' "$body" | grep -o '"pod":"[^"]*"' | sort -u | wc -l | tr -d ' ')
      echo "✅ The query returned your app's series from ${pods} pod(s) — collection is working end to end."
      exit 0 ;;
  esac
  sleep 10
done
case "$body" in
  *Forbidden*) echo "❌ The query endpoint refused the request for your OWN namespace. It authorizes on 'get pods' there, so this points at the session's permissions rather than at monitoring." >&2 ;;
  *'"result":[]'*) echo "❌ The query succeeded but returned no series after 3 minutes. The ServiceMonitor is probably selecting nothing (check its selector and port name), or user-workload monitoring is not running on this cluster." >&2 ;;
  *) echo "❌ No usable answer from $URL. Got: $(printf '%s' "${body:-<empty>}" | cut -c1-200)" >&2 ;;
esac
exit 1
