#!/bin/bash
# Verify the File PVC is Bound.
phase=$(oc get pvc hello-dcs-data -o jsonpath='{.status.phase}' 2>/dev/null)
if [ "$phase" = "Bound" ]; then
  echo "✅ PVC hello-dcs-data is Bound."
  exit 0
fi
echo "❌ PVC hello-dcs-data is '${phase:-not found}', not Bound yet. This check keeps retrying while the storage class provisions the volume." >&2
exit 1
