#!/bin/bash
# Verify the learner inspected the pre-provisioned NetworkPolicy.
# The policy is created by the session, so checking only that it EXISTS goes green before
# the learner clicks anything. Gate on the output the describe step writes instead.
f="$HOME/exercises/netpol.txt"
if ! [ -s "$f" ]; then
  echo "❌ Run the describe command above first — $f is missing or empty." >&2
  exit 1
fi
if ! grep -q 'app=hello-dcs' "$f"; then
  echo "❌ $f does not show the PodSelector 'app=hello-dcs' — re-run the describe command above." >&2
  exit 1
fi
echo "✅ you inspected 'allow-hello-dcs-ingress' — PodSelector app=hello-dcs, ingress TCP 8080."
