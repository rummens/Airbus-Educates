#!/bin/bash
# Verify the learner tried to reach the public internet and was blocked (air-gapped).
# Air-gap is a platform fact, true before the learner acts — so grade the recorded outcome
# of THEIR attempt, not the platform. The step writes output + "exit=N" to egress.txt.
f="$HOME/exercises/egress.txt"
if ! [ -s "$f" ]; then
  echo "❌ Run the oc exec command above first — $f is missing or empty." >&2
  exit 1
fi
code=$(sed -n 's/^exit=//p' "$f" | tail -1)
if [ -z "$code" ]; then
  echo "❌ $f has no exit status line — re-run the command above (it writes 'exit=N')." >&2
  exit 1
fi
if [ "$code" = "0" ]; then
  echo "❌ Your request to https://example.com SUCCEEDED — this cluster has internet egress. Real DCS blocks it; treat as an environment difference." >&2
  exit 1
fi
echo "✅ your request failed/timed out (exit=$code) — the platform is air-gapped."
