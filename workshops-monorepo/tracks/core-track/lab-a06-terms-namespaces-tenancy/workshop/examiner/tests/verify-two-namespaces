#!/bin/bash
# Verify the learner ran the command step and read its output.
# Gated on the learner's own run: the underlying state is true from session start, so a
# check that only asserts it goes green before the learner clicks anything.
f="$HOME/exercises/peers.txt"
if ! [ -s "$f" ]; then
  echo "Click the command step above first — $f is missing or empty." >&2
  exit 1
fi
if ! grep -qE '-app-a' "$f"; then
  echo "$f does not look like that command's output — re-run the step above." >&2
  exit 1
fi
if ! grep -q -- '-app-b' "$f"; then
  echo "The output is recorded, but the same check against the cluster failed — re-run the step above." >&2
  exit 1
fi
echo "OK: you can see both peer namespaces"
