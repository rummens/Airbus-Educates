#!/bin/bash
# verify-scaled <replicas> — hello-dcs is scaled to and ready at the given replica count.
set -uo pipefail


# Wait for the state this asserts, rather than reading once.
#
# Educates re-runs a red check until it passes, so a single read looks fine in a
# session — but CI runs each grader exactly once, and a controller that has not
# finished converging fails a lab that is behaving correctly. The assertion itself
# is unchanged; it is just given up to two minutes to become true.
_check() {
  want="${1:?replica count required}"
  ready=$(oc get deployment hello-dcs -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
  if [ "${ready:-0}" -ne "$want" ] 2>/dev/null; then
    echo "❌ hello-dcs has ${ready:-0} ready replicas, expected $want. Did 'oc scale deploy/hello-dcs --replicas=$want' run? Rollouts take a few seconds — this check keeps retrying." >&2
    return 1
  fi

  echo "✅ hello-dcs has $want/$want replicas ready."
}

for _ in $(seq 1 24); do
  _out=$(_check "$@" 2>&1) && { printf '%s\n' "$_out"; exit 0; }
  sleep 5
done
printf '%s\n' "$_out" >&2
exit 1
