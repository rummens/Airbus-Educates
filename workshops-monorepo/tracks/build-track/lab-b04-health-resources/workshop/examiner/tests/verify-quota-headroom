#!/bin/bash
# After right-sizing, what the app CLAIMS from the namespace budget must be a fraction
# of what it claimed on the LimitRange defaults (4 x 512Mi = the whole limit side).
#
# Read from the Deployment's own template, not from the Pods and not from the quota's
# Used figure, because both are noisy at exactly this moment: mid-rollout the retiring
# 512Mi Pods are still Running alongside the new 128Mi ones, and quota accounting lags
# Pod termination by a few seconds. The template is the desired state the learner just
# applied, and it is stable the instant the apply returns.
set -uo pipefail

to_mi() {                       # normalise Ki/Mi/Gi (and bare bytes) to MiB
  case "$1" in
    *Gi) echo $(( ${1%Gi} * 1024 )) ;;
    *Mi) echo "${1%Mi}" ;;
    *Ki) echo $(( ${1%Ki} / 1024 )) ;;
    "")  echo 0 ;;
    *)   echo $(( ${1:-0} / 1048576 )) ;;
  esac
}

lim=$(oc get deployment hello-dcs -o jsonpath='{.spec.template.spec.containers[0].resources.limits.memory}' 2>/dev/null)
replicas=$(oc get deployment hello-dcs -o jsonpath='{.spec.replicas}' 2>/dev/null)
replicas="${replicas:-4}"

if [ -z "$lim" ]; then
  echo "❌ The Deployment's container sets no memory limit, so its Pods fall back to the LimitRange default of 512Mi each and claim the whole budget. Did 'envsubst < deployment-probes.yaml | oc apply -f -' run?" >&2
  exit 1
fi

per=$(to_mi "$lim")
if [ "$per" -gt 200 ] 2>/dev/null; then
  echo "❌ Each replica still claims ${lim} of memory, expected the right-sized 128Mi from deployment-probes.yaml. Re-apply it: envsubst < deployment-probes.yaml | oc apply -f -" >&2
  exit 1
fi

claim=$(( per * replicas ))
hard=$(oc get resourcequota -o jsonpath='{.items[0].status.hard.limits\.memory}' 2>/dev/null)
if [ -n "$hard" ]; then
  h=$(to_mi "$hard")
  if [ "$claim" -ge "$h" ] 2>/dev/null; then
    echo "❌ ${replicas} replicas at ${lim} claim ${claim}Mi against a ${hard} ceiling — that is no headroom at all. Expected the right-sized template to leave most of the budget free." >&2
    exit 1
  fi
  echo "✅ ${replicas} replicas at ${lim} claim ${claim}Mi of the ${hard} limit budget — a quarter of what they took on the LimitRange defaults, with real headroom left."
  exit 0
fi
echo "✅ ${replicas} replicas at ${lim} claim ${claim}Mi of memory limits — a quarter of what they took on the LimitRange defaults."
