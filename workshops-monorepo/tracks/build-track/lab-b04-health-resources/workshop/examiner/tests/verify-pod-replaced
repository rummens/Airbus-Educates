#!/bin/bash
# Verify the specific Pod recorded during the delete step (page 05) is actually gone, and
# the Deployment has reconciled back to its desired ready-replica count — proving a real
# delete-and-replace cycle happened, not just a coincidental already-ready read.
set -uo pipefail


# Wait for the state this asserts, rather than reading once.
#
# Educates re-runs a red check until it passes, so a single read looks fine in a
# session — but CI runs each grader exactly once, and a controller that has not
# finished converging fails a lab that is behaving correctly. The assertion itself
# is unchanged; it is just given up to two minutes to become true.
_check() {
  record="/tmp/deleted-pod.txt"
  if [ ! -f "$record" ]; then
    echo "❌ No record of a deleted Pod at $record — run the delete step above first." >&2
    return 1
  fi

  deleted=$(cat "$record")
  name="${deleted#pod/}"

  if [ -z "$name" ]; then
    echo "❌ The recorded Pod name at $record is empty — re-run the delete step above." >&2
    return 1
  fi

  if oc get pod "$name" >/dev/null 2>&1; then
    echo "❌ Pod '$name' still exists — expected it gone after 'oc delete $deleted'." >&2
    return 1
  fi

  desired=$(oc get deployment hello-dcs -o jsonpath='{.spec.replicas}' 2>/dev/null)
  ready=$(oc get deployment hello-dcs -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
  if [ "${ready:-0}" -lt "${desired:-4}" ] 2>/dev/null; then
    echo "❌ hello-dcs is at ${ready:-0}/${desired:-4} ready — waiting for the replacement Pod to reach Ready. This check keeps retrying." >&2
    return 1
  fi

  echo "✅ Deleted Pod '$name' is gone, and hello-dcs is back to ${ready}/${desired} ready with a replacement."
}

for _ in $(seq 1 24); do
  _out=$(_check "$@" 2>&1) && { printf '%s\n' "$_out"; exit 0; }
  sleep 5
done
printf '%s\n' "$_out" >&2
exit 1
