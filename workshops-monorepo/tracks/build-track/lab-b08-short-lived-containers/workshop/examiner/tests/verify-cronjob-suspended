#!/bin/bash
# Suspending pauses the schedule without deleting the definition or its history.
set -uo pipefail
s=$(oc get cronjob nightly-report -o jsonpath='{.spec.suspend}' 2>/dev/null)
if [ "$s" != "true" ]; then
  echo "❌ CronJob 'nightly-report' has suspend='${s:-false}', expected true. Did the 'oc patch cronjob' step run?" >&2
  exit 1
fi
sched=$(oc get cronjob nightly-report -o jsonpath='{.spec.schedule}' 2>/dev/null)
echo "✅ CronJob nightly-report is suspended; its schedule ('${sched}') and history are intact."
