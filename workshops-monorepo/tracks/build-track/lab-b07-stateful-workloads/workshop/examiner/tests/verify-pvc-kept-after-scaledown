#!/bin/bash
# The lab's central surprise, asserted: the Pod is gone, the claim is NOT.
set -uo pipefail
want=$(oc get statefulset hello-dcs -o jsonpath='{.spec.replicas}' 2>/dev/null)
if [ "${want:-0}" -ne 2 ] 2>/dev/null; then
  echo "❌ The StatefulSet is set to ${want:-?} replicas, expected 2. Did 'oc scale statefulset/hello-dcs --replicas=2' run?" >&2
  exit 1
fi
if oc get pod hello-dcs-2 >/dev/null 2>&1; then
  echo "❌ Pod 'hello-dcs-2' still exists — scale-down removes the HIGHEST ordinal first, so it should be gone. It may still be terminating; this check keeps retrying." >&2
  exit 1
fi
phase=$(oc get pvc data-hello-dcs-2 -o jsonpath='{.status.phase}' 2>/dev/null)
if [ "$phase" != "Bound" ]; then
  echo "⚠️ Claim 'data-hello-dcs-2' is '${phase:-gone}' — this cluster deleted it with the Pod. Kubernetes keeps it by default (the data belongs to the ordinal, not the Pod); a cluster-configured persistentVolumeClaimRetentionPolicy can change that. Read the page's reasoning rather than this result." >&2
  exit 1
fi
echo "✅ Pod hello-dcs-2 is gone and claim data-hello-dcs-2 is still Bound — the volume outlived the replica, on purpose."
