#!/bin/bash
# Under load the HPA must have raised the replica count above minReplicas, and the
# Deployment must be following it.
set -uo pipefail
min=$(oc get hpa hello-dcs -o jsonpath='{.spec.minReplicas}' 2>/dev/null)
min="${min:-1}"
desired=$(oc get hpa hello-dcs -o jsonpath='{.status.desiredReplicas}' 2>/dev/null)
spec=$(oc get deployment hello-dcs -o jsonpath='{.spec.replicas}' 2>/dev/null)
if [ "${desired:-0}" -le "$min" ] 2>/dev/null && [ "${spec:-0}" -le "$min" ] 2>/dev/null; then
  echo "❌ The HPA still wants ${desired:-?} replicas and the Deployment is at ${spec:-?} — expected more than the minimum of ${min} while the load runs. The HPA samples every 15s, so give it ~30s of load; this check keeps retrying. If the current utilisation is <unknown>, no metrics are reaching the HPA." >&2
  exit 1
fi
echo "✅ The HPA scaled out: it wants ${desired} replicas (minimum is ${min}), and the Deployment is set to ${spec}."
