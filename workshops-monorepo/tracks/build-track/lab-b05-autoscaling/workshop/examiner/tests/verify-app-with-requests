#!/bin/bash
# The HPA prerequisite: the app is running AND its container sets a CPU request,
# which is the denominator of every utilisation figure the HPA will report.
set -uo pipefail
ready=$(oc get deployment hello-dcs -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
if [ "${ready:-0}" -lt 1 ] 2>/dev/null; then
  echo "❌ hello-dcs has ${ready:-0} ready replicas, expected at least 1. Did the apply step above run? The image may still be pulling — this check keeps retrying." >&2
  exit 1
fi
req=$(oc get deployment hello-dcs -o jsonpath='{.spec.template.spec.containers[0].resources.requests.cpu}' 2>/dev/null)
if [ -z "$req" ]; then
  echo "❌ The container sets no CPU request. An HPA on CPU reports <unknown> forever without one — re-apply deployment.yaml, which sets 100m." >&2
  exit 1
fi
if ! oc get service hello-dcs >/dev/null 2>&1; then
  echo "❌ Service 'hello-dcs' not found — the load step needs it as a stable address. The same apply step creates it." >&2
  exit 1
fi
echo "✅ hello-dcs is running with a CPU request of ${req}, behind a Service."
