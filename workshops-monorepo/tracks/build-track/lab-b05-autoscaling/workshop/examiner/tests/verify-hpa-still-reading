#!/bin/bash
# After the load stops the HPA must still be reporting a figure (0% is fine) — the
# point of the page is that it keeps measuring while it waits out the window.
set -uo pipefail
cur=$(oc get hpa hello-dcs -o jsonpath='{.status.currentMetrics[0].resource.current.averageUtilization}' 2>/dev/null)
if [ -z "$cur" ]; then
  echo "❌ The HPA has stopped reporting a current CPU figure. Expected a number (0% is a valid answer once the load ends). Check: oc describe hpa hello-dcs" >&2
  exit 1
fi
echo "✅ The HPA is still measuring — current CPU is ${cur}% of request while it waits out the scale-in window."
