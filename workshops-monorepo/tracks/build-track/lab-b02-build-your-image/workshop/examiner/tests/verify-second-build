#!/bin/bash
# A second run of the same recipe is a second Build object, and it must also succeed.
set -uo pipefail
for _ in $(seq 1 48); do          # ~240s
  phase=$(oc get build hello-built-2 -o jsonpath='{.status.phase}' 2>/dev/null)
  case "$phase" in
    Complete) 
      n=$(oc get builds --no-headers 2>/dev/null | wc -l | tr -d ' ')
      echo "✅ Build hello-built-2 completed — ${n} builds recorded, each a separate run."
      exit 0 ;;
    Failed|Error|Cancelled)
      echo "❌ Build hello-built-2 ended as '${phase}'. Read it: oc logs build/hello-built-2" >&2
      exit 1 ;;
  esac
  sleep 5
done
echo "❌ No completed second build after 4 minutes (phase: ${phase:-missing}). Did the second 'oc start-build' run after editing the Containerfile?" >&2
exit 1
