#!/bin/bash
# Verify devfile.yaml is present, sources its dev image from Harbor via the
# ${DCS_REGISTRY} placeholder (never a hardcoded/external registry), and
# defines the run command that starts hello-dcs.
devfile=~/exercises/devfile.yaml

if [ ! -f "$devfile" ]; then
  echo "❌ No devfile at $devfile. The session content may not have downloaded — reload the dashboard." >&2
  exit 1
fi

if ! grep -q '\${DCS_REGISTRY}' "$devfile"; then
  echo "❌ The devfile names no \${DCS_REGISTRY}. On an air-gapped platform a workspace image comes from the platform registry like everything else; a hardcoded public registry would simply not resolve." >&2
  exit 1
fi

if ! grep -q 'commandLine: python3 server.py' "$devfile"; then
  echo "❌ The devfile has no 'run' command starting hello-dcs (python3 server.py). Commands are what turn a workspace into something that can build and run the app rather than just edit it." >&2
  exit 1
fi

echo "✅ The devfile is present, takes its image from the platform registry, and defines the command that runs hello-dcs."
