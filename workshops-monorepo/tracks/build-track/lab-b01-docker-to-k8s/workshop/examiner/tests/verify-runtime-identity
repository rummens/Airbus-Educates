#!/bin/bash
# What the container actually runs as: never UID 0, and in group 0 — the two facts an
# image has to be built for.
set -uo pipefail
out=$(oc exec deploy/hello-dcs -- id 2>/dev/null)
if [ -z "$out" ]; then
  echo "❌ Could not read the container's identity. Is the app running? Check: oc get pods -l app=hello-dcs" >&2
  exit 1
fi
uid=$(printf '%s' "$out" | sed -n 's/^uid=\([0-9]*\).*/\1/p')
if [ -z "$uid" ]; then
  echo "❌ Could not parse an id from: ${out}" >&2
  exit 1
fi
if [ "$uid" = "0" ]; then
  echo "❌ The container is running as UID 0. A restricted SCC should never admit that — this cluster is not configured like DCS." >&2
  exit 1
fi
case "$out" in
  *"gid=0"*)
    echo "✅ Running as uid=${uid} in gid=0 (the root GROUP) — non-root user, predictable group. That is what images must be built for."
    exit 0 ;;
esac
echo "✅ Running as uid=${uid}, non-root. (This cluster did not put it in group 0; on OpenShift that group is what makes files writable.)"
