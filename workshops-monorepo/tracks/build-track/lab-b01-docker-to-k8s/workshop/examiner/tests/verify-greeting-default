#!/bin/bash
# Before the ConfigMap is wired in, GREETING must be unset in the container.
if ! oc get deploy hello-dcs >/dev/null 2>&1; then
  echo "❌ Deployment 'hello-dcs' not found — apply it on the previous page first." >&2
  exit 1
fi
if oc get deploy hello-dcs -o yaml 2>/dev/null | grep -q "hello-dcs-config"; then
  echo "✅ The ConfigMap is already wired in — you have run the next step. Nothing to fix."
  exit 0
fi
val=$(oc exec deploy/hello-dcs -- sh -c 'printf "%s" "${GREETING:-}"' 2>/dev/null)
if [ -z "$val" ]; then
  echo "✅ GREETING is not set in the container — the app is on its built-in default."
  exit 0
fi
echo "❌ Expected GREETING to be unset at this point, found '$val'. If you set it by hand, unset it with: oc set env deploy/hello-dcs GREETING-" >&2
exit 1
