#!/bin/bash
# Verify the Service responds over cluster DNS (same pattern as lab-a04).
ns=$(oc project -q 2>/dev/null)
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "http://hello-dcs.${ns}.svc:8080" 2>/dev/null)
if [ "$code" = "200" ]; then
  echo "✅ The Service answered HTTP 200 over cluster DNS (hello-dcs.${ns}.svc:8080)."
  exit 0
fi
echo "❌ Expected HTTP 200 from hello-dcs.${ns}.svc:8080, got '${code:-none}'. Check the Service has endpoints and the Pod is Running." >&2
exit 1
